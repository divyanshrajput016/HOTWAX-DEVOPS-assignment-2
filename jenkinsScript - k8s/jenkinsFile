
pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {

        stage('Git Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/divyanshrajput016/HOTWAX-DEVOPS-assignment-2'
            }
        }

        stage('Verify Minikube Connection') {
            steps {
                sh '''
                    set -eu

                    echo "Checking kubectl..."
                    kubectl version --client

                    echo "Checking Kubernetes context..."
                    kubectl config current-context

                    echo "Checking cluster connectivity..."
                    kubectl cluster-info

                    echo "Checking cluster nodes..."
                    kubectl get nodes -o wide
                '''
            }
        }

        stage('Apply Kubernetes Manifests') {
            steps {
                sh '''
                    set -eu

                    echo "Applying Kubernetes YAML files..."
                    kubectl apply -f k8s/

                    echo "Resources created successfully."
                '''
            }
        }

        stage('Wait for Deployments') {
            steps {
                sh '''
                    set -eu

                    echo "Waiting for deployments to become ready..."

                    kubectl get deployments -A

                    kubectl get deployments -A \
                      -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{"\\n"}{end}' \
                    | while read namespace deployment; do
                        [ -n "$deployment" ] || continue

                        echo "Waiting for $deployment in namespace $namespace"

                        kubectl rollout status deployment/"$deployment" \
                            -n "$namespace" \
                            --timeout=180s
                    done
                '''
            }
        }

        stage('Check Pods') {
            steps {
                sh '''
                    echo "Checking pods across all namespaces..."
                    kubectl get pods -A -o wide
                '''
            }
        }

        stage('Check Services') {
            steps {
                sh '''
                    echo "Checking services..."
                    kubectl get services -A

                    echo "Checking ingress resources..."
                    kubectl get ingress -A || true
                '''
            }
        }

        stage('Check Application Resources') {
            steps {
                sh '''
                    echo "Checking deployments and replica sets..."
                    kubectl get deployments,replicasets -A

                    echo "Checking recent events..."
                    kubectl get events -A \
                        --sort-by=.metadata.creationTimestamp
                '''
            }
        }
    }

    post {
        always {
            sh '''
                echo "===== FINAL POD STATUS ====="
                kubectl get pods -A -o wide || true

                echo "===== DEPLOYMENT STATUS ====="
                kubectl get deployments -A || true

                echo "===== SERVICE STATUS ====="
                kubectl get services -A || true

                echo "===== FAILED POD DETAILS ====="
                kubectl get pods -A \
                    --field-selector=status.phase=Failed || true
            '''
        }

        success {
            echo 'Kubernetes deployment pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output and Kubernetes events.'
        }
    }
}
