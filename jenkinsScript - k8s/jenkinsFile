pipeline {
    agent any

    stages {
        stage("git clone") {
            steps {
                git branch: 'main', url: 'https://github.com/divyanshrajput016/HOTWAX-DEVOPS-assignment-2'
            }
        }

        stage("apply k8s") {
            steps {
                sh '''
                kubectl apply -f k8s/
                '''
            }
        }

        stage("check pods") {
            steps {
                sh '''
                kubectl get pods
                '''
            }
        }

        stage("check services") {
            steps {
                sh '''
                kubectl get services
                '''
            }
        }

        stage("check ingress") {
            steps {
                sh '''
                kubectl get ingress
                '''
            }
        }
    }
}